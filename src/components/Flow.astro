---
// Phone view: the cabinet as a vertical Cover Flow. Native scroll + snap does
// the physics; a sticky 3D stage inside the scroller draws the cards from the
// scroll position. When scrolling settles, the centred card dims and its
// catalogue entry rises over it.
import { profile } from '../data/site';
import { specimens, flow, elsewhere, cicerone } from '../data/cabinet';

const bySlug = new Map(specimens.map((s) => [s.slug, s]));
const pad = (n: number) => String(n).padStart(2, '0');
// The introduction opens the flow on its own, printed on a miniature of the
// home planet (plate s-planet, drawn by scripts/dither.mjs), so the visitor
// starts where the desktop does: on Zumo's world.
const INTRO = 'planet';
// Door cards are for the desktop's planets; on the phone the next section is one swipe away.
const sections = flow.map(({ section, slugs }) => ({ section, slugs: slugs.filter((s) => !bySlug.get(s)!.room) }));
const cards = [
  { slug: INTRO, title: profile.name, section: 'Introduction', pos: '' } as (typeof specimens)[number] & { section: string; pos: string },
  ...sections.flatMap(({ section, slugs }) =>
    slugs.map((slug, i) => ({ ...bySlug.get(slug)!, section, pos: `${pad(i + 1)}/${pad(slugs.length)}` })),
  ),
];
// Which of the desktop's worlds each section lives on: the phone's sky follows it.
const WORLD: Record<string, string> = { Projects: 'pc', Experience: 'pc', Garden: 'home', Gallery: 'station', Posts: 'station' };
const starts = sections.map(({ section, slugs }) => ({
  section,
  count: slugs.length,
  index: cards.findIndex((c) => c.section === section),
}));
---
<div class="flow" data-flow data-world="home">
  <div class="f-sky" aria-hidden="true">
    <i class="f-stars"></i>
    {['home', 'pc', 'station'].map((w) => <img class="f-world" data-w={w} src={`/img/w-${w}.png`} width="320" height="130" alt="" />)}
  </div>
  <p class="f-zumo on" data-f-zumo data-lines={JSON.stringify(cicerone.phone)} data-worlds={JSON.stringify(WORLD)} aria-live="polite">
    <img src="/favicon.svg" width="30" height="30" alt="" />
    <span class="f-say" data-f-say>{cicerone.phone.intro}</span>
  </p>
  <header class="f-bar caps">
    <span class="f-me">
      Daniel Fenoll
      <button type="button" class="f-theme" data-theme-toggle aria-pressed="false" aria-label="Switch to night">
        <svg class="i-moon" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="0" width="1" height="1"/><rect x="2" y="1" width="1" height="1"/><rect x="3" y="1" width="1" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="2" y="2" width="1" height="1"/><rect x="1" y="3" width="1" height="1"/><rect x="2" y="3" width="1" height="1"/><rect x="0" y="4" width="1" height="1"/><rect x="1" y="4" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="1" y="5" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect x="3" y="5" width="1" height="1"/><rect x="4" y="5" width="1" height="1"/><rect x="1" y="6" width="1" height="1"/><rect x="2" y="6" width="1" height="1"/><rect x="3" y="6" width="1" height="1"/><rect x="4" y="6" width="1" height="1"/><rect x="5" y="6" width="1" height="1"/><rect x="6" y="6" width="1" height="1"/><rect x="7" y="6" width="1" height="1"/><rect x="2" y="7" width="1" height="1"/><rect x="3" y="7" width="1" height="1"/><rect x="4" y="7" width="1" height="1"/><rect x="5" y="7" width="1" height="1"/><rect x="6" y="7" width="1" height="1"/><rect x="4" y="8" width="1" height="1"/></svg>
        <svg class="i-sun" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="2" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="4" y="3" width="1" height="1"/><rect x="5" y="3" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="5" y="4" width="1" height="1"/><rect x="6" y="4" width="1" height="1"/><rect x="3" y="5" width="1" height="1"/><rect x="4" y="5" width="1" height="1"/><rect x="5" y="5" width="1" height="1"/><rect x="4" y="6" width="1" height="1"/><rect x="4" y="0" width="1" height="1"/><rect x="4" y="8" width="1" height="1"/><rect x="0" y="4" width="1" height="1"/><rect x="8" y="4" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="7" y="1" width="1" height="1"/><rect x="1" y="7" width="1" height="1"/><rect x="7" y="7" width="1" height="1"/></svg>
      </button>
      <button type="button" class="f-theme f-sound" data-sound-toggle aria-pressed="true" aria-label="Mute sound">
        <svg class="i-loud" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true"><rect x="0" y="3" width="2" height="3"/><rect x="2" y="2" width="1" height="5"/><rect x="3" y="1" width="1" height="7"/><rect x="5" y="3" width="1" height="3"/><rect x="6" y="1" width="1" height="1"/><rect x="7" y="2" width="1" height="5"/><rect x="6" y="7" width="1" height="1"/></svg>
        <svg class="i-mute" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true"><rect x="0" y="3" width="2" height="3"/><rect x="2" y="2" width="1" height="5"/><rect x="3" y="1" width="1" height="7"/><rect x="5" y="3" width="1" height="1"/><rect x="8" y="3" width="1" height="1"/><rect x="6" y="4" width="2" height="1"/><rect x="6" y="5" width="2" height="1"/><rect x="5" y="6" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/></svg>
      </button>
    </span>
    <span class="f-where" aria-live="polite">
      <span class="f-sec"><span data-f-sec>{starts[0].section}</span></span>
      <span class="f-num"><span data-f-local>01</span> / <span data-f-total>{pad(starts[0].count)}</span></span>
    </span>
  </header>

  <div class="f-scroll" data-f-scroll tabindex="0" aria-label="Cabinet, one card per specimen">
    <div class="f-stage">
      {cards.map((c, i) => (
        <article class="card" data-card={i} aria-labelledby={`f-t-${i}`}>
          <img src={`/img/s-${c.slug}.png`} width="160" height="200" alt="" loading={i < 4 ? 'eager' : 'lazy'} />
          <div class="depth" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <div class="info">
            <p class="kick caps">{c.section} <span>{c.pos}</span></p>
            {i === 0 ? (
              <div class="body">
                <p class="kana pixel" lang="ja">{profile.kana}</p>
                <h2 id={`f-t-${i}`} class="title">{profile.name}</h2>
                <p class="meta caps">Senior software engineer · Alicante</p>
                <p class="text">{profile.statement}</p>
                <ul class="links">
                  {elsewhere.map((l) => (
                    <li><a href={l.href} {...(!l.href.startsWith('mailto:') ? { target: '_blank', rel: 'me noopener' } : {})}>{l.label}</a></li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="body">
                <h2 id={`f-t-${i}`} class="title" lang={c.lang}>{c.title}</h2>
                <p class="meta caps">{c.kind} · {c.year}</p>
                <p class="medium">{c.medium}</p>
                <p class="text">{c.text}</p>
                {c.href && <a class="cta" href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.link ?? 'Open'} <span aria-hidden="true">↗</span></a>}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <nav class="f-tabs caps" aria-label="Sections">
    <div class="f-rail" data-f-rail>
      {starts.map((s) => (
        <button type="button" data-f-jump={s.index} data-f-count={s.count} data-f-section={s.section}>
          <span class="f-label">{s.section}</span>
          <span class="f-seg" aria-hidden="true"><i class="f-fill"></i></span>
        </button>
      ))}
      <span
        class="f-dot"
        data-f-dot
        role="slider"
        tabindex="0"
        aria-label="Scrub through the cards"
        aria-valuemin="1"
        aria-valuemax={cards.length}
        aria-valuenow="1"
      ></span>
      <span class="f-bubble caps" data-f-bubble aria-hidden="true"></span>
    </div>
  </nav>
</div>

<script>
  import { play } from '../scripts/sound';
  const phone = matchMedia('(max-width: 760px)');
  let started = false;


  // ── The sky's passers-by ──
  // Pixel sprites, all rects so they stay crisp when scaled. By day a plane,
  // a balloon, birds; by night a satellite, a comet, a shooting star, a
  // ringed planet. Clouds drift past all the time, faint at night.
  const C = { ink: '#262e3a', red: '#d26046', ochre: '#ecb656', cream: '#f8f0de', blue: '#3e9ab2', olive: '#608a52' };
  const rects = (list: [number, number, number, number, string, number?][]) =>
    list.map(([x, y, w, h, f, o]) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${f}"${o ? ` opacity="${o}"` : ''}/>`).join('');
  const sprite = (w: number, h: number, body: string) =>
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w * 3}" height="${h * 3}" shape-rendering="crispEdges">${body}</svg>`;
  const balloonRows: [number, number][] = [[4, 6], [2, 10], [1, 12], [0, 14], [0, 14], [0, 14], [0, 14], [1, 12], [2, 10], [3, 8], [4, 6], [5, 4]];
  const SPRITES: Record<string, string> = {
    cloud: sprite(24, 10, rects([[4, 3, 16, 7, C.cream], [7, 0, 8, 4, C.cream], [14, 1, 6, 3, C.cream], [0, 6, 24, 4, C.cream]])),
    plane: sprite(20, 10, rects([[2, 4, 14, 3, C.cream], [16, 4, 2, 3, C.red], [2, 1, 2, 3, C.cream], [2, 1, 2, 1, C.red], [12, 4, 2, 1, C.blue], [6, 6, 7, 1, C.ink], [18, 2, 1, 7, C.ink], [3, 5, 13, 1, C.red]])),
    balloon: sprite(14, 18, balloonRows.map(([x, w], y) => rects([[x, y, w, 1, C.red], [Math.max(x, 5), y, Math.min(4, w), 1, C.ochre]])).join('') + rects([[4, 12, 1, 3, C.ink], [9, 12, 1, 3, C.ink], [4, 15, 6, 3, C.ochre], [4, 15, 6, 1, C.ink]])),
    birds: sprite(16, 7, rects([[0, 1, 2, 1, C.ink], [2, 2, 1, 1, C.ink], [3, 1, 2, 1, C.ink], [8, 4, 2, 1, C.ink], [10, 5, 1, 1, C.ink], [11, 4, 2, 1, C.ink], [12, 0, 2, 1, C.ink], [14, 1, 1, 1, C.ink], [15, 0, 1, 1, C.ink]])),
    satellite: sprite(16, 8, rects([[6, 2, 4, 4, C.ochre], [0, 3, 5, 2, C.blue], [11, 3, 5, 2, C.blue], [5, 4, 1, 1, C.cream], [10, 4, 1, 1, C.cream], [7, 0, 1, 2, C.cream]])),
    comet: sprite(26, 6, rects([[0, 2, 3, 3, C.cream], [3, 2, 5, 2, C.cream, 0.85], [8, 3, 7, 1, C.cream, 0.55], [15, 3, 10, 1, C.cream, 0.25], [1, 1, 1, 1, C.ochre]])),
    star: sprite(14, 3, rects([[0, 1, 2, 1, C.cream], [2, 1, 5, 1, C.cream, 0.6], [7, 1, 7, 1, C.cream, 0.25]])),
    planet: sprite(18, 12, rects([[0, 5, 18, 2, C.ochre], [5, 2, 8, 1, C.olive], [4, 3, 10, 6, C.olive], [5, 9, 8, 1, C.olive], [6, 4, 3, 2, C.cream, 0.5], [0, 6, 4, 1, C.ochre], [14, 6, 4, 1, C.ochre]])),
  };
  type Pass = { kind: string; y: [number, number]; dur: [number, number]; diag?: boolean; rise?: number };
  const PASSES: Record<string, Pass[]> = {
    day: [
      { kind: 'plane', y: [0.08, 0.22], dur: [15000, 21000] },
      { kind: 'balloon', y: [0.1, 0.28], dur: [38000, 50000], rise: -40 },
      { kind: 'birds', y: [0.06, 0.24], dur: [11000, 15000] },
    ],
    dark: [
      { kind: 'satellite', y: [0.05, 0.16], dur: [24000, 32000] },
      { kind: 'comet', y: [0.04, 0.14], dur: [6500, 9000], diag: true },
      { kind: 'star', y: [0.03, 0.2], dur: [1200, 1700], diag: true },
      { kind: 'planet', y: [0.06, 0.18], dur: [50000, 65000] },
    ],
  };
  function ambience(root: HTMLElement, reduced: MediaQueryList) {
    const sky = root.querySelector<HTMLElement>('.f-sky')!;
    const html = document.documentElement;
    const dark = () => (html.dataset.theme ? html.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
    const between = ([a, b]: [number, number]) => a + Math.random() * (b - a);
    for (let k = 0; k < 3; k++) {
      const c = document.createElement('i');
      c.className = 'f-cloud';
      c.innerHTML = SPRITES.cloud;
      c.style.top = `${6 + k * 9 + Math.random() * 4}%`;
      c.style.animationDuration = `${70 + k * 18}s`;
      c.style.animationDelay = `${-Math.random() * 70}s`;
      c.style.scale = String(0.8 + k * 0.25);
      sky.prepend(c);
    }
    if (reduced.matches) return;
    let live = 0;
    const pass = () => {
      window.setTimeout(pass, 5000 + Math.random() * 7000);
      if (document.hidden || live >= 2) return;
      const pool = PASSES[dark() ? 'dark' : 'day'];
      const p = pool[Math.floor(Math.random() * pool.length)];
      const el = document.createElement('i');
      el.className = `f-pass f-${p.kind}`;
      el.innerHTML = SPRITES[p.kind];
      sky.append(el);
      const W = sky.clientWidth;
      const H = sky.clientHeight;
      const w = el.offsetWidth;
      const y = between(p.y) * H;
      const ltr = p.diag ? false : Math.random() < 0.5;
      const x0 = ltr ? -w - 10 : W + 10;
      const x1 = ltr ? W + 10 : -w - 10;
      const y1 = p.diag ? y + H * 0.22 : y + (p.rise ?? 0);
      const flip = !ltr && !p.diag && p.kind !== 'balloon' ? ' scaleX(-1)' : ''; // sprites are drawn facing right
      const tilt = p.diag ? ` rotate(${Math.atan2(y1 - y, x1 - x0) * (180 / Math.PI) + 180}deg)` : '';
      live++;
      const run = el.animate(
        [
          { transform: `translate(${x0}px, ${y}px)${tilt}${flip}`, opacity: p.kind === 'star' ? 0 : 1 },
          { transform: `translate(${(x0 + x1) / 2}px, ${(y + y1) / 2}px)${tilt}${flip}`, opacity: 1, offset: 0.5 },
          { transform: `translate(${x1}px, ${y1}px)${tilt}${flip}`, opacity: p.kind === 'star' ? 0 : 1 },
        ],
        { duration: between(p.dur), easing: 'linear' },
      );
      const done = () => {
        live--;
        el.remove();
      };
      run.onfinish = done;
      run.oncancel = done;
    };
    window.setTimeout(pass, 2500);
  }

  function start() {
    if (started || !phone.matches) return;
    started = true;

    const root = document.querySelector<HTMLElement>('[data-flow]')!;
    const scroller = root.querySelector<HTMLElement>('[data-f-scroll]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-f-jump]')];
    const rail = root.querySelector<HTMLElement>('[data-f-rail]')!;
    const dot = root.querySelector<HTMLElement>('[data-f-dot]')!;
    const fills = tabs.map((t) => t.querySelector<HTMLElement>('.f-fill')!);
    const segs = tabs.map((t) => t.querySelector<HTMLElement>('.f-seg')!);
    const secEl = root.querySelector<HTMLElement>('[data-f-sec]')!;
    const localEl = root.querySelector<HTMLElement>('[data-f-local]')!;
    const whereEl = root.querySelector<HTMLElement>('.f-where')!;
    const totalEl = root.querySelector<HTMLElement>('[data-f-total]')!;
    const zumo = root.querySelector<HTMLElement>('[data-f-zumo]')!;
    const say = root.querySelector<HTMLElement>('[data-f-say]')!;
    const lines: Record<string, string> = JSON.parse(zumo.dataset.lines!);
    const worlds: Record<string, string> = JSON.parse(zumo.dataset.worlds!);
    let here = 'intro';
    let hush = 0;
    const sections = tabs.map((t) => ({ name: t.dataset.fSection!, start: +t.dataset.fJump!, count: +t.dataset.fCount! }));
    let segBox: { x: number; w: number }[] = [];
    let current = -1; // section index
    let lastAt = 0;
    let lastT = 0;
    let relax = 0;
    let scrubbing = false;
    const bubble = root.querySelector<HTMLElement>('[data-f-bubble]')!;
    const titles = cards.map((c) => c.querySelector('.title')?.textContent ?? '');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    ambience(root, reduced);
    const n = cards.length;

    let step = 1; // scroll distance between two cards, px
    let ch = 1; // card height, px
    let active = -1; // card whose info is showing
    let nearest = -1;
    let pos = 0; // position along the flow, px (step px per card)

    const measure = () => {
      ch = cards[0].offsetHeight;
      step = Math.round(ch * 0.5);
      root.style.setProperty('--step', `${step}px`);
      const r = rail.getBoundingClientRect();
      segBox = segs.map((sg) => {
        const b = sg.getBoundingClientRect();
        return { x: b.left - r.left, w: b.width };
      });
      const s0 = segs[0].getBoundingClientRect();
      dot.style.top = `${s0.top - r.top + s0.height / 2}px`;
    };

    // Progress rail: every section fills as you move through it, and the dot
    // rides the leading edge across all four, stretching with scroll speed.
    function progress(at: number) {
      // Card k of a section of n reads as k/n: the last card fills it.
      const c = Math.max(0, Math.min(n - 1, at));
      const fill = (s: (typeof sections)[number]) => Math.max(0, Math.min(1, (c - s.start + 1) / s.count));
      let k = 0;
      sections.forEach((s, j) => {
        fills[j].style.transform = `scaleX(${fill(s)})`;
        if (c > s.start - 1) k = j;
      });
      const s = sections[k];
      const p = fill(s);
      const box = segBox[k];
      const dx = box ? box.x + p * box.w : 0;
      if (box) dot.style.translate = `${dx}px -50%`;

      const now = performance.now();
      const v = Math.abs(at - lastAt) / Math.max(1, now - lastT); // cards per ms
      lastAt = at;
      lastT = now;
      clearTimeout(relax);
      if (scrubbing) {
        // held: the dot is a grip, and a bubble names the card under it
        dot.style.scale = '1.9 1.9';
        const i = Math.max(0, Math.min(n - 1, Math.round(c)));
        bubble.textContent = titles[i];
        const half = bubble.offsetWidth / 2;
        bubble.style.translate = `${Math.max(half, Math.min(rail.clientWidth - half, dx))}px 0`;
      } else {
        dot.style.scale = `${1 + Math.min(v * 90, 2.2)} 1`;
        relax = window.setTimeout(() => (dot.style.scale = '1 1'), 90);
      }

      if (k !== current) {
        const down = k > current;
        current = k;
        secEl.textContent = s.name;
        totalEl.textContent = String(s.count).padStart(2, '0');
        tabs.forEach((t, j) => t.setAttribute('aria-current', String(j === k)));
        if (!reduced.matches && lastT > 0)
          secEl.animate(
            [
              { transform: `translateY(${down ? 100 : -100}%)`, opacity: 0 },
              { transform: 'none', opacity: 1 },
            ],
            { duration: 420, easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)' },
          );
      }
      return s;
    }

    // Cover Flow, turned on its side. d is a card's distance from centre, in cards.
    function draw() {
      const at = pos / step;
      for (let i = 0; i < n; i++) {
        const d = i - at;
        const el = cards[i];
        const far = Math.abs(d);
        if (far > 4.5) {
          el.style.visibility = 'hidden';
          continue;
        }
        el.style.visibility = '';
        const a = Math.max(-1, Math.min(1, d)); // the turn happens within one card of centre
        const rest = d - a; // beyond that, cards stack like a deck
        let t: string;
        if (reduced.matches) {
          t = `translate3d(0, ${d * ch * 1.08}px, 0)`;
        } else {
          const y = a * ch * 0.6 + rest * ch * 0.12;
          const z = -Math.abs(a) * ch * 1.05 - Math.abs(rest) * ch * 0.1;
          t = `translate3d(0, ${y}px, ${z}px) rotateX(${a * 58}deg)`;
        }
        el.style.transform = t;
        el.style.zIndex = String(100 - Math.round(far * 10));
        el.style.setProperty('--dim', String(Math.min(far, 3) * 0.2));
      }
      const s = progress(at);
      const i = Math.max(0, Math.min(n - 1, Math.round(at)));
      if (i !== nearest) {
        if (nearest >= 0) play('flip');
        nearest = i;
        dot.setAttribute('aria-valuenow', String(i + 1));
        localEl.textContent = String(Math.max(1, Math.min(s.count, i - s.start + 1))).padStart(2, '0');
        // the introduction belongs to no section: no counter over it
        whereEl.style.visibility = i < sections[0].start ? 'hidden' : '';
        travel(i < sections[0].start ? 'intro' : worlds[s.name]);
      }
    }

    // The sky turns into the world the cards belong to, and the juice box says where you are.
    function travel(w: string) {
      if (w === here) return;
      here = w;
      root.dataset.world = w === 'intro' ? 'home' : w;
      clearTimeout(hush);
      zumo.classList.remove('on');
      window.setTimeout(() => {
        say.textContent = lines[w] ?? '';
        zumo.classList.add('on');
        [0, 90, 180, 270].forEach((t) => window.setTimeout(() => play('blip'), t));
        if (w !== 'intro') hush = window.setTimeout(() => zumo.classList.remove('on'), 3800);
      }, 180);
    }

    function open(i: number) {
      if (active === i) return;
      close();
      active = i;
      cards[i].classList.add('open');
      play('open');
    }
    function close() {
      if (active < 0) return;
      cards[active].classList.remove('open');
      active = -1;
      play('close');
    }
    // Resting: the card the flow stopped on shows its plate clean; its entry
    // rises after a beat (see settle).
    let rested = -1;
    function rest(i: number) {
      if (rested === i) return;
      unrest();
      rested = i;
      cards[i].classList.add('rest');
    }
    function unrest() {
      clearTimeout(openTimer);
      if (rested < 0) return;
      cards[rested].classList.remove('rest');
      rested = -1;
    }
    // Half a second after the flow comes to rest on a card, its entry rises
    // by itself. Moving on before then means it never does.
    const OPEN_DELAY = 500;
    let openTimer = 0;

    let drawRaf = 0;
    const schedule = () => {
      if (!drawRaf) drawRaf = requestAnimationFrame(() => ((drawRaf = 0), draw()));
    };

    // Settled = resting exactly on a card.
    function settle() {
      if (!step) return; // not laid out: the phone flow is hidden on a desktop
      const i = Math.round(pos / step);
      if (Math.abs(pos - i * step) > 2) return;
      const k = Math.max(0, Math.min(n - 1, i));
      if (rested === k) return; // already resting here (and maybe closed by a tap)
      rest(k);
      clearTimeout(openTimer);
      openTimer = window.setTimeout(() => {
        if (rested === k && !drag && !scrubbing) open(k);
      }, OPEN_DELAY);
    }

    // ── Motion: a spring that starts from wherever the flow is now, carrying
    // the finger's velocity, so the hand-off from drag to animation has no seam
    // and the flow can be caught again mid-flight.
    const RESPONSE = 0.42; // s
    const DAMPING = 1; // critically damped: arrives without bouncing back
    let spring: { target: number; v: number } | null = null;
    let springRaf = 0;
    let springLast = 0;
    function stopSpring() {
      spring = null;
      cancelAnimationFrame(springRaf);
      springRaf = 0;
    }
    function tick(now: number) {
      springRaf = 0;
      if (!spring) return;
      let dt = Math.min(0.064, (now - springLast) / 1000);
      springLast = now;
      const k = (2 * Math.PI / RESPONSE) ** 2;
      const c = (4 * Math.PI * DAMPING) / RESPONSE;
      while (dt > 0) {
        const h = Math.min(dt, 1 / 240);
        spring.v += (-k * (pos - spring.target) - c * spring.v) * h;
        pos += spring.v * h;
        dt -= h;
      }
      if (Math.abs(pos - spring.target) < 0.3 && Math.abs(spring.v) < 8) {
        pos = spring.target;
        spring = null;
        draw();
        settle();
        return;
      }
      draw();
      springRaf = requestAnimationFrame(tick);
    }
    function goTo(i: number, v = 0) {
      i = Math.max(0, Math.min(n - 1, i));
      if (i !== active) close();
      if (i !== rested) unrest();
      if (reduced.matches) {
        stopSpring();
        pos = i * step;
        draw();
        settle();
        return;
      }
      // Hand over the finger's speed, but never more than the remaining
      // distance can absorb: a critically damped spring overshoots when
      // v > ω·distance, and that overshoot is the fast-swipe rebound.
      const dist = i * step - pos;
      const omega = (2 * Math.PI) / RESPONSE;
      v = v * dist <= 0 ? 0 : Math.sign(dist) * Math.min(Math.abs(v), omega * Math.abs(dist) * 0.9);
      spring = { target: i * step, v };
      if (!springRaf) {
        springLast = performance.now();
        springRaf = requestAnimationFrame(tick);
      }
    }

    // ── Gesture: one card per swipe; only a hard flick travels further.
    // The flow follows the finger 1:1. On release, Apple's momentum projection
    // says where the swipe was heading; that is limited to the neighbouring
    // card unless the flick was genuinely strong.
    const rubber = (over: number, dim: number) => (over * dim * 0.55) / (dim + 0.55 * over);
    let drag: { y0: number; p0: number; base: number; moved: boolean; trail: { y: number; t: number }[] } | null = null;
    let swallowClick = false;
    // Press and hold an open card (about half a second, finger still) to see
    // its plate clean for as long as the finger stays down.
    const HOLD = 450;
    let holdTimer = 0;
    let peeking = false;
    const endPeek = () => {
      clearTimeout(holdTimer);
      if (!peeking) return;
      peeking = false;
      cards.forEach((c) => c.classList.remove('peek'));
    };
    scroller.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      stopSpring();
      drag = { y0: e.clientY, p0: pos, base: Math.round(pos / step), moved: false, trail: [{ y: e.clientY, t: e.timeStamp }] };
      clearTimeout(holdTimer);
      holdTimer = window.setTimeout(() => {
        if (!drag || drag.moved || active < 0 || Math.round(pos / step) !== active) return;
        peeking = true;
        swallowClick = true; // lifting the finger must not also count as a tap
        cards[active].classList.add('peek');
        navigator.vibrate?.(6);
      }, HOLD);
    });
    scroller.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dy = e.clientY - drag.y0;
      if (!drag.moved) {
        if (Math.abs(dy) < 8) return; // a tap, until it clearly isn't
        endPeek();
        drag.moved = true;
        swallowClick = true;
        scroller.setPointerCapture(e.pointerId);
        close();
        unrest();
      }
      drag.trail.push({ y: e.clientY, t: e.timeStamp });
      if (drag.trail.length > 6) drag.trail.shift();
      const max = (n - 1) * step;
      let p = drag.p0 - dy;
      if (p < 0) p = -rubber(-p, ch);
      else if (p > max) p = max + rubber(p - max, ch);
      pos = p;
      schedule();
    });
    const release = (e: PointerEvent) => {
      const d = drag;
      drag = null;
      if (!d) return;
      if (peeking) {
        endPeek();
        setTimeout(() => (swallowClick = false));
        return;
      }
      clearTimeout(holdTimer);
      if (!d.moved) {
        // a still touch that caught a moving flow: let it finish where it was going
        if (Math.abs(pos - Math.round(pos / step) * step) > 1) goTo(Math.round(pos / step));
        return;
      }
      setTimeout(() => (swallowClick = false));
      const a = d.trail[0];
      const b = d.trail[d.trail.length - 1];
      let v = (-(b.y - a.y) / Math.max(1, b.t - a.t)) * 1000; // px/s along the flow
      if (e.timeStamp - b.t > 90) v = 0; // the finger stopped before lifting
      const projected = pos + ((v / 1000) * 0.99) / (1 - 0.99);
      const strong = Math.abs(v) > 2600;
      const reach = strong ? Math.min(4, Math.round(Math.abs(v) / 1400)) : 1;
      // A short swipe counts from the card it started on; a drag that already
      // travelled more than a card counts from where the finger let go, so
      // it is never pulled back.
      const base = Math.abs(pos - d.p0) < step * 1.5 ? d.base : Math.round(pos / step);
      let target = Math.max(base - reach, Math.min(base + reach, Math.round(projected / step)));
      // A short, deliberate swipe still turns the card.
      if (target === base && base === d.base) {
        const moved = pos - base * step;
        if (Math.abs(v) > 260) target = base + Math.sign(v);
        else if (Math.abs(moved) > step * 0.2) target = base + Math.sign(moved);
      }
      goTo(target, v);
    };
    scroller.addEventListener('pointerup', release);
    scroller.addEventListener('pointercancel', release);
    scroller.addEventListener(
      'click',
      (e) => {
        if (!swallowClick) return;
        e.stopPropagation();
        e.preventDefault();
        swallowClick = false;
      },
      true,
    );

    // Wheel and keys (a mouse on a narrow window): one card per intent.
    // Count from where the flow is heading, so quick repeats add up.
    const heading = () => Math.round((spring ? spring.target : pos) / step);
    let wheelAcc = 0;
    let wheelLock = 0;
    scroller.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        wheelAcc += e.deltaY;
        if (Math.abs(wheelAcc) < 30 || e.timeStamp < wheelLock) return;
        goTo(heading() + Math.sign(wheelAcc));
        wheelAcc = 0;
        wheelLock = e.timeStamp + 350;
      },
      { passive: false },
    );
    scroller.addEventListener('keydown', (e) => {
      const here = heading();
      const to = { ArrowDown: here + 1, PageDown: here + 1, ArrowUp: here - 1, PageUp: here - 1, Home: 0, End: n - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      goTo(to);
    });

    // Tap: a neighbour comes to centre; the centred card toggles its entry.
    cards.forEach((el, i) =>
      el.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (i !== nearest) goTo(i);
        else if (active === i) close();
        else open(i);
      }),
    );
    tabs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.fJump))));

    // ── Scrub: drag the red dot along the rail to fly through every card.
    // The rail maps back to cards exactly as it was drawn (card k of a
    // section of n sits at k/n of its segment), so the dot stays under the
    // finger and the cards follow it live.
    function cardAt(x: number) {
      let k = 0;
      segBox.forEach((b, j) => {
        if (x >= b.x - 3) k = j; // halfway across the 6px gap
      });
      const s = sections[k];
      const b = segBox[k];
      const p = Math.max(0, Math.min(1, (x - b.x) / b.w));
      return Math.max(Math.max(0, s.start - 0.49), Math.min(s.start + s.count - 1, s.start - 1 + p * s.count));
    }
    let tickAt = -1;
    const scrubTo = (e: PointerEvent) => {
      const c = cardAt(e.clientX - rail.getBoundingClientRect().left);
      pos = c * step;
      const i = Math.round(c);
      if (i !== tickAt) {
        tickAt = i;
        dot.setAttribute('aria-valuenow', String(i + 1));
        navigator.vibrate?.(4); // a detent per card where the device supports it
      }
      draw();
    };
    dot.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dot.setPointerCapture(e.pointerId);
      stopSpring();
      close();
      unrest();
      scrubbing = true;
      tickAt = Math.round(pos / step);
      root.classList.add('scrubbing');
      scrubTo(e);
    });
    dot.addEventListener('pointermove', (e) => scrubbing && scrubTo(e));
    const endScrub = () => {
      if (!scrubbing) return;
      scrubbing = false;
      root.classList.remove('scrubbing');
      goTo(Math.round(pos / step));
    };
    dot.addEventListener('pointerup', endScrub);
    dot.addEventListener('pointercancel', endScrub);
    dot.addEventListener('click', (e) => e.stopPropagation());
    dot.addEventListener('keydown', (e) => {
      const here = heading();
      const to = { ArrowRight: here + 1, ArrowUp: here + 1, ArrowLeft: here - 1, ArrowDown: here - 1, Home: 0, End: n - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      goTo(to);
      dot.setAttribute('aria-valuenow', String(Math.max(0, Math.min(n - 1, to)) + 1));
    });

    const relayout = () => {
      const i = Math.max(0, nearest);
      stopSpring();
      measure();
      pos = i * step;
      draw();
    };
    new ResizeObserver(relayout).observe(scroller);
    reduced.addEventListener('change', draw);

    measure();
    draw();
    // Arrival is just another rest: the first card (who this is) opens after the same beat.
    requestAnimationFrame(settle);
  }

  start();
  phone.addEventListener('change', start);
</script>

