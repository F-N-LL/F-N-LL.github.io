---
// Pixel meander: the Greek key of a Pompeian fresco border, which is also the
// raimon (雷文) spiral on a ramen bowl. One tile, repeated as a background.
const tile = [
  '#########',
  '.........',
  '#######..',
  '#.....#..',
  '#.###.#..',
  '#.#.#.#..',
  '#.#...#..',
  '#.#####..',
  '#........',
  '#########',
];
const px = 3;
const rects = tile.flatMap((row, y) =>
  [...row].map((c, x) => (c === '#' ? `<rect x="${x}" y="${y}" width="1" height="1"/>` : '')).filter(Boolean),
);
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${tile[0].length} ${tile.length}" width="${tile[0].length * px}" height="${tile.length * px}" shape-rendering="crispEdges" fill="black">${rects.join('')}</svg>`;
const mask = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---
<div class="meander" style={`--meander:${mask};--meander-w:${tile[0].length * px}px;--meander-h:${tile.length * px}px`} aria-hidden="true"></div>

<style>
  .meander {
    height: var(--meander-h);
    background: var(--accent);
    -webkit-mask: var(--meander) repeat-x left center / var(--meander-w) var(--meander-h);
    mask: var(--meander) repeat-x left center / var(--meander-w) var(--meander-h);
    opacity: 0.85;
  }
</style>
